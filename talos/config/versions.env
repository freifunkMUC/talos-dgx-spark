# Pinned versions for the DGX Spark / GB10 Talos build.
#
# Single source of truth for scripts/build_image.sh and the CI workflow.
# The extension tags embed the Talos version (kmod) or the NVIDIA driver
# version (toolkit), so they must move together with TALOS_VERSION.
# Regenerate with: talos/scripts/update_versions.sh <talos-version>
#
# Sources for the current pins (checked 2026-11-19):
#   https://github.com/siderolabs/talos/releases/tag/v1.14.6   (Linux 6.18.63)
#   https://github.com/siderolabs/extensions/releases/tag/v1.14.6
#   https://factory.talos.dev/version/v1.14.6/extensions/official
#
# NVIDIA driver: GB10 needs the proprietary ("nonfree") kernel modules on
# Talos >= 1.13 (Clang/ThinLTO kernel with BTI); the open modules load but
# CUDA fails (cuInit=3) or the node crashes. See siderolabs/talos#13019,
# #14087 and the Talos v1.14 "NVIDIA GPU (Proprietary drivers)" docs.
# Driver branch "production" = 595.112.07, "lts" = 580.196.07; both arm64.

TALOS_VERSION=v1.14.6
ARCH=arm64

IMAGER_IMAGE=ghcr.io/siderolabs/imager:v1.14.6@sha256:726987ad71fc86f098ed77e0fc4cdd594a21f428cefa4970517461e2e631b3b8
# talosctl for CI validation (sha256 from the release's sha256sum.txt)
TALOSCTL_LINUX_AMD64_SHA256=11acde7f7578ffe9cbe6fb8349b34595065f597de0842615982e350b365de987

INSTALLER_BASE_IMAGE=ghcr.io/siderolabs/installer-base:v1.14.6@sha256:c124e2a46957a819bb89679cb7bb0d7aff020ea223c409829ff78fd83b7206a3

# System extensions baked into installer/ISO/disk image (order is irrelevant).
EXT_NVIDIA_KMOD=ghcr.io/siderolabs/nonfree-kmod-nvidia-production:595.112.07-v1.14.6@sha256:fc4330467cf36e4dfedfecd733e17052262ae691d5c60ab9b7598f3bc3cc6554
EXT_NVIDIA_TOOLKIT=ghcr.io/siderolabs/nvidia-container-toolkit-production:595.112.07-v1.19.1@sha256:44b192dd3e16d2f833f98fe67c3429c25837fc7b7945e0797ae693e8c73bec8e
# rtl_nic/rtl8127a-1.fw for the onboard 10GbE RTL8127 (driver r8169 is in the base kernel since 6.16)
EXT_REALTEK_FIRMWARE=ghcr.io/siderolabs/realtek-firmware:20261019@sha256:619b0249090b526fb624e1bc7e12d5732a2ec8f5ae18138e70feb221c8b90a2a
# mstflint for querying/updating ConnectX-7 firmware from a debug pod (optional, small)
EXT_MELLANOX_MSTFLINT=ghcr.io/siderolabs/mellanox-mstflint:4.34.1-4-v1.14.6@sha256:0e2ded0d0ab69e49404e783eb8d47c02959af874f186b68fae7ff0dd57326fcb

# Kernel arguments baked into the UKI (machine.install.extraKernelArgs is
# ignored with systemd-boot/UKI). Space-separated.
#   arm64.nobti  required for the NVIDIA modules on GB10 (Talos >= 1.13)
EXTRA_KERNEL_ARGS="arm64.nobti"

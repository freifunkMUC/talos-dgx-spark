# Pinned versions for the DGX Spark / GB10 Talos build.
#
# Single source of truth for scripts/build_image.sh and the CI workflow.
# The extension tags embed the Talos version (kmod) or the NVIDIA driver
# version (toolkit), so they must move together with TALOS_VERSION.
# Regenerate with: talos/scripts/update_versions.sh <talos-version>
#
# Sources for the current pins (checked 2026-10-21):
#   https://github.com/siderolabs/talos/releases/tag/v1.14.4   (Linux 6.18.57, pkgs v1.14.0-44-g2ec10eb)
#   https://github.com/siderolabs/extensions/releases/tag/v1.14.4
#   https://factory.talos.dev/version/v1.14.4/extensions/official
#
# NVIDIA driver: GB10 needs the proprietary ("nonfree") kernel modules on
# Talos >= 1.13 (Clang/ThinLTO kernel with BTI); the open modules load but
# CUDA fails (cuInit=3) or the node crashes. See siderolabs/talos#13019,
# #14087 and the Talos v1.14 "NVIDIA GPU (Proprietary drivers)" docs.
# Driver branch "production" = 595.91.07, "lts" = 580.178.04; both arm64.

TALOS_VERSION=v1.14.4
ARCH=arm64

IMAGER_IMAGE=ghcr.io/siderolabs/imager:v1.14.4@sha256:91d453a7cf57d499fe7fe7923e1e381b6e1535136367246d190e38486c11651d
# talosctl for CI validation (sha256 from the release's sha256sum.txt)
TALOSCTL_LINUX_AMD64_SHA256=0a69e3f9b682c5cd844b78dae305f6056ceb86c5fcc6913dcea78c527ed97cee

INSTALLER_BASE_IMAGE=ghcr.io/siderolabs/installer-base:v1.14.4@sha256:bc4757f02b2afab8a7176b85d9aff809d189db2975bee6494e503fe50eb03dee

# System extensions baked into installer/ISO/disk image (order is irrelevant).
EXT_NVIDIA_KMOD=ghcr.io/siderolabs/nonfree-kmod-nvidia-production:595.91.07-v1.14.4@sha256:6a9d7b75ea191060147550fdee3d04679fb9c699041a3e80b3f528e1ab53cedd
EXT_NVIDIA_TOOLKIT=ghcr.io/siderolabs/nvidia-container-toolkit-production:595.91.07-v1.19.1@sha256:c5ac6dbffdadd1e0d242b51082d3f7bb522ea239af2cdb003139dc401b40c3e1
# rtl_nic/rtl8127a-1.fw for the onboard 10GbE RTL8127 (driver r8169 is in the base kernel since 6.16)
EXT_REALTEK_FIRMWARE=ghcr.io/siderolabs/realtek-firmware:20260916@sha256:044fca109a4427e8c96ae1286213ddf168df1ea6203135f8d49b83d3630c0840
# mstflint for querying/updating ConnectX-7 firmware from a debug pod (optional, small)
EXT_MELLANOX_MSTFLINT=ghcr.io/siderolabs/mellanox-mstflint:4.34.1-4-v1.14.4@sha256:fceeb38f8c223a21a2ba6e10890b2887cc76a621ada3deb0c5d679c11656a77c

# Kernel arguments baked into the UKI (machine.install.extraKernelArgs is
# ignored with systemd-boot/UKI). Space-separated.
#   arm64.nobti  required for the NVIDIA modules on GB10 (Talos >= 1.13)
EXTRA_KERNEL_ARGS="arm64.nobti"
